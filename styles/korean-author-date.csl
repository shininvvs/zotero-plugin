<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
	default-locale="ko-KR" demote-non-dropping-particle="never" page-range-format="expanded">
	<info>
		<title>한국어 저자-연도 (Korean Author-Date)</title>
		<title-short>한국어 저자-연도</title-short>
		<id>https://github.com/shininvvs/zotero-plugin/raw/main/styles/korean-author-date.csl</id>
		<link href="https://github.com/shininvvs/zotero-plugin/raw/main/styles/korean-author-date.csl" rel="self"/>
		<link href="https://github.com/shininvvs/zotero-plugin" rel="documentation"/>
		<category citation-format="author-date"/>
		<category field="generic-base"/>
		<summary>국내 인문·사회계열에서 널리 쓰이는 저자-연도 형식. 저자는 가운뎃점으로 잇고, 논문 제목은 큰따옴표, 단행본과 학술지명은 겹낫표로 적는다. 한국어 CSL 로케일이 조사를 "와/과" 로 내보내는 문제를 피하기 위해 저자 연결에 접속 조사를 쓰지 않는다.</summary>
		<updated>2026-08-27T00:00:00+00:00</updated>
		<rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
	</info>

	<!--
		기본 로케일이 학술 인용에 맞지 않는 부분을 덮는다.
		특히 and 는 쓰지 않고 저자를 가운뎃점으로만 잇는다.
	-->
	<locale xml:lang="ko">
		<terms>
			<term name="et-al">외</term>
			<term name="in">수록</term>
			<term name="editor" form="short">엮음</term>
			<term name="translator" form="short">옮김</term>
			<term name="edition" form="short">판</term>
			<term name="no date">연도 미상</term>
			<term name="accessed">열람</term>
			<term name="page" form="short">
				<single/>
				<multiple/>
			</term>
		</terms>
	</locale>

	<!--
		이름은 적힌 순서 그대로 둔다. 성을 앞으로 돌리면 서양 저자가
		"Meng, Chutian·Fan Ma" 처럼 쉼표와 가운뎃점이 뒤섞여 읽기 나쁘다.
		정렬은 author-sort 가 따로 맡는다.
	-->
	<macro name="author">
		<names variable="author">
			<name delimiter="·"/>
			<label form="short" prefix=" "/>
			<substitute>
				<names variable="editor"/>
				<names variable="translator"/>
				<text macro="title"/>
			</substitute>
		</names>
	</macro>

	<!-- 목록 정렬용. 화면에 나오지 않으므로 성을 앞으로 돌려도 된다. -->
	<macro name="author-sort">
		<names variable="author">
			<name name-as-sort-order="all" delimiter=" " sort-separator=" "/>
			<substitute>
				<names variable="editor"/>
				<names variable="translator"/>
				<text variable="title"/>
			</substitute>
		</names>
	</macro>

	<macro name="author-short">
		<names variable="author">
			<name form="short" delimiter="·"/>
			<substitute>
				<names variable="editor"/>
				<names variable="translator"/>
				<text variable="title" form="short"/>
			</substitute>
		</names>
	</macro>

	<macro name="issued">
		<choose>
			<if variable="issued">
				<date variable="issued">
					<date-part name="year"/>
				</date>
			</if>
			<else>
				<text term="no date"/>
			</else>
		</choose>
	</macro>

	<!-- 단행본류는 겹낫표, 낱글은 큰따옴표 -->
	<macro name="title">
		<choose>
			<if type="book thesis report manuscript motion_picture song graphic map" match="any">
				<text variable="title" prefix="『" suffix="』"/>
			</if>
			<else>
				<text variable="title" quotes="true"/>
			</else>
		</choose>
	</macro>

	<macro name="editor-translator">
		<group delimiter=", ">
			<names variable="editor">
				<name delimiter="·"/>
				<label form="short" prefix=" "/>
			</names>
			<names variable="translator">
				<name delimiter="·"/>
				<label form="short" prefix=" "/>
			</names>
		</group>
	</macro>

	<macro name="publisher">
		<group delimiter=": ">
			<text variable="publisher-place"/>
			<text variable="publisher"/>
		</group>
	</macro>

	<!-- 권(호) 형태. 호가 없으면 권만 -->
	<macro name="volume-issue">
		<group>
			<text variable="volume"/>
			<text variable="issue" prefix="(" suffix=")"/>
		</group>
	</macro>

	<macro name="locators">
		<choose>
			<if type="article-journal article-magazine article-newspaper" match="any">
				<group delimiter=": ">
					<group delimiter=" ">
						<text variable="container-title" prefix="『" suffix="』"/>
						<text macro="volume-issue"/>
					</group>
					<text variable="page"/>
				</group>
			</if>
			<else-if type="chapter paper-conference" match="any">
				<group delimiter=", ">
					<group delimiter=" ">
						<text variable="container-title" prefix="『" suffix="』"/>
						<text macro="editor-translator"/>
					</group>
					<text variable="page"/>
				</group>
			</else-if>
			<else-if type="thesis">
				<group delimiter=", ">
					<text variable="genre"/>
					<text variable="publisher"/>
				</group>
			</else-if>
			<else-if type="report">
				<group delimiter=", ">
					<group delimiter=" ">
						<text variable="collection-title"/>
						<text variable="number"/>
					</group>
					<text macro="publisher"/>
				</group>
			</else-if>
			<else-if type="webpage post post-weblog" match="any">
				<text variable="container-title"/>
			</else-if>
			<else>
				<text macro="publisher"/>
			</else>
		</choose>
	</macro>

	<macro name="access">
		<choose>
			<if type="webpage post post-weblog" match="any">
				<group delimiter=" ">
					<text variable="URL"/>
					<group prefix="(" suffix=")" delimiter=" ">
						<date variable="accessed">
							<date-part name="year" suffix="년 "/>
							<date-part name="month" form="numeric" suffix="월 "/>
							<date-part name="day" suffix="일"/>
						</date>
						<text term="accessed"/>
					</group>
				</group>
			</if>
			<else-if variable="DOI">
				<text variable="DOI" prefix="https://doi.org/"/>
			</else-if>
		</choose>
	</macro>

	<citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true"
		disambiguate-add-names="true" collapse="year">
		<sort>
			<key macro="author-sort"/>
			<key macro="issued"/>
		</sort>
		<layout prefix="(" suffix=")" delimiter="; ">
			<group delimiter=", ">
				<text macro="author-short"/>
				<text macro="issued"/>
				<text variable="locator"/>
			</group>
		</layout>
	</citation>

	<bibliography hanging-indent="true" et-al-min="7" et-al-use-first="6" entry-spacing="0">
		<sort>
			<key macro="author-sort"/>
			<key macro="issued"/>
		</sort>
		<layout suffix=".">
			<group delimiter=". ">
				<text macro="author"/>
				<text macro="issued"/>
				<text macro="title"/>
				<text macro="locators"/>
				<text macro="access"/>
			</group>
		</layout>
	</bibliography>
</style>
